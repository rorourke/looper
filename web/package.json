    "typecheck": "tsc --noEmit",
    "verify:artifacts": "node ../script/verify_client_artifacts.mjs web"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rebound": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
