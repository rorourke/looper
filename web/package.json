{
  "name": "looper-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "test": "node --experimental-transform-types --test lib/*.test.ts",
    "build": "next build && node ../script/verify_client_artifacts.mjs web",
